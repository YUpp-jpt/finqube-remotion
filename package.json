    "render": "node tools/render.mjs",
    "verify": "node tools/verify.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "ffmpeg-static": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
