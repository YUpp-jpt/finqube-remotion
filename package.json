{
  "name": "finqube-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "A frame-based Remotion recreation of the Finqube product presentation.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "check": "tsc --noEmit",
